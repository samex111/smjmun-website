// ─── Prisma Schema ─────────────────────────────────────────────────
// SMJ MUN — PostgreSQL (Neon) via Prisma ORM 7
// ────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum RegistrationStatus {
  PENDING_OTP
  PENDING_PAYMENT
  PAID
  PAYMENT_FAILED
  CANCELLED
  REFUNDED
}

enum InquiryStatus {
  NEW
  CONTACTED
  CLOSED
}

enum SubscriptionSource {
  FOOTER
  BLOG
  CONTACT
  HOMEPAGE
  CONFERENCE
  PARTNERSHIP
  POPUP
  OTHER
}

enum SubscriptionStatus {
  ACTIVE
  UNSUBSCRIBED
}

enum SupportChannel {
  WEBSITE
  WHATSAPP
}

enum SupportUrgency {
  NORMAL
  HIGH
  CRITICAL
}

enum SupportStatus {
  OPEN
  NOTIFIED
  RESOLVED
}

enum WhatsAppMessageDirection {
  INBOUND
  OUTBOUND
}

enum WhatsAppMessageRole {
  USER
  AI
  HUMAN
  SYSTEM
}

enum WhatsAppNotificationType {
  PAYMENT_CONFIRMATION
}

enum WhatsAppNotificationStatus {
  PENDING
  SENT
  FAILED
}

model Registration {
  id        String   @id @default(cuid())

  // Student info
  email       String
  firstName   String
  lastName    String
  phone       String
  institution String
  city        String?

  // Conference snapshot (denormalized from Sanity)
  conferenceId    String
  conferenceTitle String
  conferenceDate  DateTime?
  conferenceFee   Float
  currency        String    @default("INR")

  // Preferences
  committeePreference  String?
  dietaryRequirements  String?

  // Explicit WhatsApp transactional-notification consent
  whatsappUpdatesConsent Boolean   @default(false)
  whatsappConsentAt      DateTime?

  // Registration lifecycle
  status RegistrationStatus @default(PENDING_OTP)

  // Payment (HDFC / Juspay)
  hdfcOrderId String? @unique
  paymentId   String?
  paidAt      DateTime?

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  whatsappLinks         WhatsAppRegistrationLink[]
  whatsappNotifications WhatsAppNotification[]
  supportCases          SupportCase[]

  // One registration per email per conference
  @@unique([email, conferenceId])

  // Query indexes
  @@index([conferenceId])
  @@index([status])
  @@index([email])
}

model RegistrationDraft {
  id String @id @default(cuid())

  email       String
  firstName   String
  lastName    String
  phone       String
  institution String

  city                 String?
  committeePreference  String?
  dietaryRequirements  String?
  whatsappUpdatesConsent Boolean @default(false)

  conferenceId String

  createdAt DateTime @default(now())

  @@index([email])
}

model OtpVerification {
  id String @id @default(cuid())

  email     String
  otpHash   String
  expiresAt DateTime
  verified  Boolean @default(false)
  attempts  Int     @default(0)

  createdAt DateTime @default(now())

  @@index([email])
}

// Email OTP challenge used to link a registration to a WhatsApp number.
model WhatsAppLinkChallenge {
  id             String   @id @default(cuid())
  registrationId String
  email          String
  otpHash        String
  consentRequested Boolean @default(false)
  expiresAt      DateTime
  attempts       Int      @default(0)
  createdAt      DateTime @default(now())

  @@index([registrationId, email])
}

// Only a hash of the short-lived LINK token is stored.
model WhatsAppLinkToken {
  tokenHash      String   @id
  registrationId String
  expiresAt      DateTime
  usedAt         DateTime?
  createdAt      DateTime @default(now())

  @@index([registrationId])
}

model WhatsAppIdentity {
  waId       String   @id
  createdAt  DateTime @default(now())
  registrations WhatsAppRegistrationLink[]
}

model WhatsAppRegistrationLink {
  id             String   @id @default(cuid())
  waId           String
  registrationId String
  isVerified     Boolean  @default(false)
  createdAt      DateTime @default(now())

  identity     WhatsAppIdentity @relation(fields: [waId], references: [waId], onDelete: Cascade)
  registration Registration     @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  @@unique([waId, registrationId])
  @@index([registrationId])
}

model WhatsAppConversation {
  id                 String   @id @default(cuid())
  waId               String   @unique
  activeHumanHandoff Boolean  @default(false)
  lastMessageAt      DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  messages     WhatsAppMessage[]
  supportCases SupportCase[]
}

model WhatsAppMessage {
  id             String   @id @default(cuid())
  conversationId String
  waMessageId    String   @unique
  waId           String
  direction      WhatsAppMessageDirection
  role           WhatsAppMessageRole
  content        String   @db.Text
  rawPayload     Json?
  createdAt      DateTime @default(now())

  conversation WhatsAppConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model SupportCase {
  id              String   @id @default(cuid())
  channel         SupportChannel
  sessionId       String?
  waId            String?
  registrationId  String?
  requesterName   String?
  requesterEmail  String?
  requesterPhone  String?
  reason          String
  requestedAction String   @db.Text
  summary         String   @db.Text
  urgency         SupportUrgency @default(NORMAL)
  status          SupportStatus  @default(OPEN)
  humanRepliedAt  DateTime?
  reminderSentAt DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  registration Registration?       @relation(fields: [registrationId], references: [id], onDelete: SetNull)
  conversation WhatsAppConversation? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([waId, createdAt])
}

model WhatsAppNotification {
  id             String   @id @default(cuid())
  registrationId String
  type           WhatsAppNotificationType
  status         WhatsAppNotificationStatus @default(PENDING)
  messageId      String?
  error          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  registration Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  @@unique([registrationId, type])
  @@index([status, updatedAt])
}

// Persistent fixed-window counters shared by Vercel instances.
model RateLimitCounter {
  key        String
  windowStart DateTime
  count      Int      @default(0)
  expiresAt  DateTime

  @@id([key, windowStart])
  @@index([expiresAt])
}

model PartnershipInquiry {
  id              String   @id @default(cuid())
  institutionName String
  contactPerson   String
  email           String
  phone           String?
  institutionType String?
  message         String?
  status          InquiryStatus @default(NEW)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status])
  @@index([email])
}

model ContactInquiry {
  id      String @id @default(cuid())
  name    String
  email   String
  phone   String?
  subject String?
  message String
  status  InquiryStatus @default(NEW)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([email])
}

model VolunteerApplication {
  id           String @id @default(cuid())
  name         String
  email        String
  phone        String
  institution  String
  experience   String?
  motivation   String?
  conferenceId String?

  createdAt DateTime @default(now())

  @@index([email])
}

model ExecutiveBoardApplication {
  id                 String @id @default(cuid())
  name               String
  email              String
  phone              String
  institution        String
  experience         String
  preferredCommittee String?
  portfolio          String?
  conferenceId       String?

  createdAt DateTime @default(now())

  @@index([email])
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  source    SubscriptionSource
  status    SubscriptionStatus @default(ACTIVE)
  ipAddress String?
  userAgent String?

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  unsubscribedAt DateTime?

  @@index([email])
  @@index([status])
  @@index([source])
}
